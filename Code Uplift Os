class LoginPage(tk.Frame):
    def __init__(self, parent, controller):
        super().__init__(parent)
        self.controller = controller
        tk.Label(self, text="Log In", font=("Arial", 14)).pack(side="top", fill="x", pady=10)

        tk.Label(self, text="Email").pack()
        self.email_entry = tk.Entry(self)
        self.email_entry.pack()

        tk.Label(self, text="Password").pack()
        self.password_entry = tk.Entry(self, show="*")
        self.password_entry.pack()

        tk.Button(self, text="Log In", command=self.log_in).pack(pady=10)
        tk.Button(self, text="Back", command=lambda: controller.show_frame("StartPage")).pack()

    def log_in(self):
        email = self.email_entry.get().strip()
        password = self.password_entry.get().strip()
        if not email or not password:
            handle_error("Email and password cannot be empty")
            return
        if not validate_email(email):
            handle_error("Invalid email format")
            return
        for user_id, user in self.controller.ai_agent.users.items():
            if user.email == email and user.password == password:
                self.controller.current_user_id = user_id
                messagebox.showinfo("Success", f"Logged in successfully as {user.name}")
                self.controller.show_frame("StartPage")
                return
        handle_error("Invalid email or password")

class ProfilePage(tk.Frame):
