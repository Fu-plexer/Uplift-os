        if not self.controller.current_user_id:
            handle_error("You must be logged in to view your profile")
            self.controller.show_frame("StartPage")
            return
        super().tkraise(*args, **kwargs)
        self.display_profile()

    def display_profile(self):
        user = self.controller.ai_agent.users.get(self.controller.current_user_id)
        if user:
            self.profile_display.delete(1.0, tk.END)
            self.profile_display.insert(tk.END, f"Name: {user.name}\n")
            self.profile_display.insert(tk.END, f"Email: {user.email}\n")
            self.profile_display.insert(tk.END, f"Interests: {', '.join(user.interests)}\n")
            self.profile_display.insert(tk.END, f"Skills: {', '.join(user.skills)}\n")
            self.profile_display.insert(tk.END, f"Goals: {', '.join(user.goals)}\n")
            self.profile_display.insert(tk.END, f"Privacy: {user.privacy_setting}\n")
            self.privacy_var.set(user.privacy_setting)

    def update_profile(self):
        if not self.controller.current_user_id:
            handle_error("You must be logged in to update your profile")
            return
        interests = self.interests_entry.get().strip().split(',')
        skills = self.skills_entry.get().strip().split(',')
        goals = self.goals_entry.get().strip().split(',')
        privacy_setting = self.privacy_var.get()
        self.controller.ai_agent.update_profile(self.controller.current_user_id, 
                                              interests=interests, 
                                              skills=skills, 
                                              goals=goals, 
                                              privacy_setting=privacy_setting)
        messagebox.showinfo("Success", "Profile updated successfully")
        self.display_profile()

