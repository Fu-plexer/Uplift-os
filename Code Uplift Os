        self.interests_entry.pack()

        tk.Label(self, text="Skills (comma-separated)").pack()
        self.skills_entry = tk.Entry(self)
        self.skills_entry.pack()

        tk.Label(self, text="Goals (comma-separated)").pack()
        self.goals_entry = tk.Entry(self)
        self.goals_entry.pack()

        tk.Label(self, text="Privacy Setting").pack()
        self.privacy_var = tk.StringVar(value="public")
        tk.Radiobutton(self, text="Public", variable=self.privacy_var, value="public").pack()
        tk.Radiobutton(self, text="Private", variable=self.privacy_var, value="private").pack()

        tk.Button(self, text="Create Profile", command=self.create_profile).pack(pady=10)
        tk.Button(self, text="Back", command=lambda: controller.show_frame("StartPage")).pack()

    def create_profile(self):
        username = self.username_entry.get().strip()
        email = self.email_entry.get().strip()
        password = self.password_entry.get().strip()
        interests = self.interests_entry.get().strip().split(',')
        skills = self.skills_entry.get().strip().split(',')
        goals = self.goals_entry.get().strip().split(',')
        privacy_setting = self.privacy_var.get()

        if not all([username, email, password]):
            handle_error("All fields must be filled")
            return
        if not validate_email(email):
            handle_error("Invalid email format")
            return
        try:
            user_id = str(uuid.uuid4())
            user = self.controller.ai_agent.create_user(user_id, username, email, password)
            self.controller.ai_agent.update_profile(user_id, interests=interests, skills=skills, goals=goals, privacy_setting=privacy_setting)
            messagebox.showinfo("Success", "Profile created successfully")
            self.controller.show_frame("StartPage")
        except ValueError as e:
            handle_error(str(e))

