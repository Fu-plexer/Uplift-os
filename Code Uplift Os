class PhotosPage(tk.Frame):
    def __init__(self, parent, controller):
        super().__init__(parent)
        self.controller = controller
        tk.Label(self, text="Photos", font=("Arial", 14)).pack(side="top", fill="x", pady=10)
        
        tk.Button(self, text="Back", command=lambda: controller.show_frame("StartPage")).pack()

        tk.Button(self, text="Upload Photo", command=self.upload_photo).pack(pady=5)

        self.photo_display = tk.Label(self)
        self.photo_display.pack()

    def upload_photo(self):
        if not self.controller.current_user_id:
            handle_error("You must be logged in to upload photos")
            return
        file_path = filedialog.askopenfilename(filetypes=[("Image Files", "*.png;*.jpg;*.jpeg;*.gif")])
        if file_path:
            try:
                img = Image.open(file_path)
                img = img.resize((300, 300), Image.Resampling.LANCZOS)
                photo = ImageTk.PhotoImage(img)
                self.photo_display.config(image=photo)
                self.photo_display.image = photo
                user = self.controller.ai_agent.users[self.controller.current_user_id]
                user.photos.append(file_path)
                self.controller.ai_agent.save_users()
            except Exception as e:
                handle_error(f"Could not load image: {e}")

class SongsPage(tk.Frame):
    def __init__(self, parent, controller):
        super().__init__(parent)
        self.controller = controller
        tk.Label(self, text="Songs", font=("Arial", 14)).pack(side="top", fill="x", pady=10)
        
        tk.Button(self, text="Back", command=lambda: controller.show_frame("StartPage")).pack()

        tk.Button(self, text="Upload Song", command=self.upload_song).pack(pady=5)

        self.song_listbox = tk.Listbox(self, width=50)
        self.song_listbox.pack()

        tk.Button(self, text="Play Song", command=self.play_song).pack(pady=5)
        tk.Button(self, text="Stop Song", command=self.stop_song).pack(pady=5)

    def upload_song(self):
        if not self.controller.current_user_id:
            handle_error("You must be logged in to upload songs")
            return
        file_path = filedialog.askopenfilename(filetypes=[("Audio Files", "*.mp3;*.wav;*.ogg")])
        if file_path:
            self.song_listbox.insert(tk.END, os.path.basename(file_path))
            self.song_listbox.file_paths = getattr(self.song_listbox, 'file_paths', []) + [file_path]
            user = self.controller.ai_agent.users[self.controller.current_user_id]
            user.songs.append(file_path)
            self.controller.ai_agent.save_users()

    def play_song(self):
        selected_index = self.song_listbox.curselection()
        if not selected_index:
            handle_error("No song selected")
            return
        selected_song = self.song_listbox.file_paths[selected_index[0]]
        try:
            pygame.mixer.music.load(selected_song)
            pygame.mixer.music.play()
            messagebox.showinfo("Playing", f"Playing {os.path.basename(selected_song)}")
        except Exception as e:
            handle_error(f"Could not play song: {e}")

    def stop_song(self):
        pygame.mixer.music.stop()
        messagebox.showinfo("Stopped", "Song playback stopped")

class ConnectionsPage(tk.Frame):
    def __init__(self, parent, controller):
        super().__init__(parent)
        self.controller = controller
        tk.Label(self, text="Connections", font=("Arial", 14)).pack(side="top", fill="x", pady=10)
        
        tk.Button(self, text="Back", command=lambda: controller.show_frame("StartPage")).pack()

        tk.Label(self, text="Search by Skill, Interest, or Name").pack()
        self.search_entry = tk.Entry(self)
        self.search_entry.pack()
        tk.Button(self, text="Search", command=self.search_users).pack(pady=5)

        tk.Label(self, text="Recommendations").pack()
        self.recommendations_listbox = tk.Listbox(self, width=50)
        self.recommendations_listbox.pack()

        tk.Button(self, text="Refresh Recommendations", command=self.refresh_recommendations).pack(pady=5)
        tk.Button(self, text="Connect", command=self.connect_with_user).pack(pady=5)
        tk.Button(self, text="View Profile", command=self.view_user_profile).pack(pady=5)

        tk.Label(self, text="Your Connections").pack()
        self.connections_listbox = tk.Listbox(self, width=50)
        self.connections_listbox.pack()

        tk.Button(self, text="Remove Connection", command=self.remove_connection).pack(pady=5)

    def refresh_recommendations(self):
        if not self.controller.current_user_id:
            handle_error("Please log in to see recommendations")
            return
        recommendations = self.controller.ai_agent.recommend_connections(self.controller.current_user_id)
        self.recommendations_listbox.delete(0, tk.END)
        for user_id in recommendations:
            user = self.controller.ai_agent.users[user_id]
            self.recommendations_listbox.insert(tk.END, f"{user.name} ({user_id})")
        # Display current connections
        self.connections_listbox.delete(0, tk.END)
        user = self.controller.ai_agent.users.get(self.controller.current_user_id)
        for user_id in user.connections:
            conn_user = self.controller.ai_agent.users[user_id]
            self.connections_listbox.insert(tk.END, f"{conn_user.name} ({user_id})")

    def connect_with_user(self):
        if not self.controller.current_user_id:
            handle_error("Please log in to connect with users")
            return
        selected_index = self.recommendations_listbox.curselection()
        if not selected_index:
            handle_error("Please select a user to connect with")
            return
        selected_item = self.recommendations_listbox.get(selected_index)
        other_user_id = selected_item.split('(')[-1].split(')')[0]
        try:
            self.controller.ai_agent.accept_connection(self.controller.current_user_id, other_user_id)
            messagebox.showinfo("Success", f"Connected with {self.controller.ai_agent.users[other_user_id].name}")
            self.refresh_recommendations()
        except ValueError as e:
            handle_error(str(e))

    def remove_connection(self):
        if not self.controller.current_user_id:
            handle_error("Please log in to remove connections")
            return
        selected_index = self.connections_listbox.curselection()
        if not selected_index:
            handle_error("Please select a connection to remove")
            return
        selected_item = self.connections_listbox.get(selected_index)
        other_user_id = selected_item.split('(')[-1].split(')')[0]
        try:
            self.controller.ai_agent.remove_connection(self.controller.current_user_id, other_user_id)
            messagebox.showinfo("Success", f"Removed connection with {self.controller.ai_agent.users[other_user_id].name}")
            self.refresh_recommendations()
        except ValueError as e:
            handle_error(str(e))

    def view_user_profile(self):
        if not self.controller.current_user_id:
            handle_error("Please log in to view profiles")
            return
        selected_index = self.recommendations_listbox.curselection() or self.connections_listbox.curselection()
        if not selected_index:
            handle_error("Please select a user to view their profile")
            return
        selected_item = (self.recommendations_listbox.get(selected_index) if self.recommendations_listbox.curselection()
                        else self.connections_listbox.get(selected_index))
        other_user_id = selected_item.split('(')[-1].split(')')[0]
        user = self.controller.ai_agent.users.get(other_user_id)
        if not user:
            handle_error("User not found")
            return
        if user.privacy_setting == "private" and other_user_id not in self.controller.ai_agent.users[self.controller.current_user_id].connections:
            handle_error("This user's profile is private")
            return
        self.controller.frames["UserProfilePage"].set_user(other_user_id)
        self.controller.show_frame("UserProfilePage")

    def search_users(self):
        query = self.search_entry.get().strip()
        if not query:
            handle_error("Search query cannot be empty")
            return
        skill_results = self.controller.ai_agent.search_users_by_skill(query)
        interest_results = self.controller.ai_agent.search_users_by_interest(query)
        name_results = [uid for uid, user in self.controller.ai_agent.users.items() 
                       if query.lower() in user.name.lower() and user.privacy_setting == "public"]
        results = set(skill_results + interest_results + name_results) - set([self.controller.current_user_id])
        self.recommendations_listbox.delete(0, tk.END)
        for user_id in results:
            user = self.controller.ai_agent.users[user_id]
            self.recommendations_listbox.insert(tk.END, f"{user.name} ({user_id})")
        if not results:
            messagebox.showinfo("Info", "No users found matching the query")

class UserProfilePage(tk.Frame):
    def __init__(self, parent, controller):
        super().__init__(parent)
        self.controller = controller
        self.current_profile_id = None

        tk.Label(self, text="User Profile", font=("Arial", 14)).pack(side="top", fill="x", pady=10)
        tk.Button(self, text="Back", command=self.go_back).pack()

        # Profile info
        self.profile_display = scrolledtext.ScrolledText(self, width=50, height=10)
        self.profile_display.pack()

        # Tabs for content
        self.tab_frame = tk.Frame(self)
        self.tab_frame.pack(fill="x", pady=5)
        self.content_frame = tk.Frame(self)
        self.content_frame.pack(fill="both", expand=True)

        self.message_button = tk.Button(self.tab_frame, text="Messages", command=self.show_messages)
        self.message_button.pack(side="left", padx=5)
        self.photo_button = tk.Button(self.tab_frame, text="Photos", command=self.show_photos)
        self.photo_button.pack(side="left", padx=5)
        self.song_button = tk.Button(self.tab_frame, text="Songs", command=self.show_songs)
        self.song_button.pack(side="left", padx=5)

        # Messages display
        self.message_display = scrolledtext.ScrolledText(self.content_frame, width=50, height=10)
        # Photos canvas
        self.photo_canvas = tk.Canvas(self.content_frame, width=300, height=300)
        self.photo_scrollbar = tk.Scrollbar(self.content_frame, orient="vertical", command=self.photo_canvas.yview)
        self.photo_frame = tk.Frame(self.photo_canvas)
        self.photo_frame.bind("<Configure>", lambda e: self.photo_canvas.configure(scrollregion=self.photo_canvas.bbox("all")))
        self.photo_canvas.create_window((0, 0), window=self.photo_frame, anchor="nw")
        self.photo_canvas.configure(yscrollcommand=self.photo_scrollbar.set)
        # Songs listbox
        self.song_listbox = tk.Listbox(self.content_frame, width=50)
        tk.Button(self.content_frame, text="Play Song", command=self.play_song).pack()
        tk.Button(self.content_frame, text="Stop Song", command=self.stop_song).pack()

        self.current_content = None

    def set_user(self, user_id):
        self.current_profile_id = user_id
        self.display_profile()

    def tkraise(self, *args, **kwargs):
        if not self.current_profile_id:
            handle_error("No user profile selected")
            self.controller.show_frame("StartPage")
            return
        super().tkraise(*args, **kwargs)
        self.display_profile()

    def go_back(self):
        if self.controller.current_user_id and self.current_profile_id == self.controller.current_user_id:
            self.controller.show_frame("ViewProfilePage")
        else:
            self.controller.show_frame("ConnectionsPage")

    def display_profile(self):
        user = self.controller.ai_agent.users.get(self.current_profile_id)
        if not user:
            handle_error("User not found")
            self.controller.show_frame("StartPage")
            return
        self.profile_display.delete(1.0, tk.END)
        self.profile_display.insert(tk.END, f"Name: {user.name}\n")
        self.profile_display.insert(tk.END, f"Interests: {', '.join(user.interests)}\n")
        self.profile_display.insert(tk.END, f"Skills: {', '.join(user.skills)}\n")
        self.profile_display.insert(tk.END, f"Goals: {', '.join(user.goals)}\n")
        self.profile_display.insert(tk.END, f"Privacy: {user.privacy_setting}\n")
        self.show_messages()

    def show_messages(self):
        self.clear_content()
        self.current_content = "messages"
        self.message_display.pack(fill="both", expand=True)
        user = self.controller.ai_agent.users.get(self.current_profile_id)
        self.message_display.delete(1.0, tk.END)
        for msg in user.messages:
            self.message_display.insert(tk.END, f"{msg}\n")

    def show_photos(self):
        self.clear_content()
        self.current_content = "photos"
        self.photo_canvas.pack(side="left", fill="both", expand=True)
        self.photo_scrollbar.pack(side="right", fill="y")
        user = self.controller.ai_agent.users.get(self.current_profile_id)
        for widget in self.photo_frame.winfo_children():
            widget.destroy()
        self.photo_images = []
        for file_path in user.photos:
            if os.path.exists(file_path):
                try:
                    img = Image.open(file_path)
                    img = img.resize((100, 100), Image.Resampling.LANCZOS)
                    photo = ImageTk.PhotoImage(img)
                    label = tk.Label(self.photo_frame, image=photo)
                    label.image = photo
                    self.photo_images.append(photo)
                    label.pack(pady=5)
                except Exception as e:
                    print(f"Could not load photo {file_path}: {e}")

    def show_songs(self):
        self.clear_content()
        self.current_content = "songs"
        self.song_listbox.pack(fill="both", expand=True)
        self.song_listbox.file_paths = []
        self.song_listbox.delete(0, tk.END)
        user = self.controller.ai_agent.users.get(self.current_profile_id)
        for file_path in user.songs:
            if os.path.exists(file_path):
                self.song_listbox.insert(tk.END, os.path.basename(file_path))
                self.song_listbox.file_paths.append(file_path)

    def clear_content(self):
        if self.current_content == "messages":
            self.message_display.pack_forget()
        elif self.current_content == "photos":
            self.photo_canvas.pack_forget()
            self.photo_scrollbar.pack_forget()
        elif self.current_content == "songs":
            self.song_listbox.pack_forget()
        self.current_content = None

    def play_song(self):
        selected_index = self.song_listbox.curselection()
        if not selected_index:
            handle_error("No song selected")
            return
        selected_song = self.song_listbox.file_paths[selected_index[0]]
        try:
            pygame.mixer.music.load(selected_song)
            pygame.mixer.music.play()
            messagebox.showinfo("Playing", f"Playing {os.path.basename(selected_song)}")
        except Exception as e:
            handle_error(f"Could not play song: {e}")

    def stop_song(self):
        pygame.mixer.music.stop()
        messagebox.showinfo("Stopped", "Song playback stopped")

